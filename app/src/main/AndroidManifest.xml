<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- الأذونات المطلوبة فقط - بدون أي إذن زائد -->
    <!-- مطلوب من أندرويد 13 (API 33) فأعلى لو استخدمنا إشعار الخدمة الأمامية -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- اختياري: إشعار أثناء التخليق الصوتي الطويل (نصوص كبيرة) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- الخدمة الأمامية لتنزيل ملفات ونماذج الأصوات المدمجة في الخلفية (ع٣٠-7) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- الخدمة الأمامية الخاصة بالإعلانات الدورية (نوع متخصص لا يقيده
         أندرويد 15 عند الإقلاع، بخلاف mediaPlayback) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- ضروري لطلب Audio Focus قبل نطق الإعلان (بدونه يرمي النظام
         SecurityException ويُبتلع طلب التركيز فيفشل صوت الخلفية) — إذن عادي
         يُمنح عند التثبيت تلقائياً بلا طلب وقت التشغيل -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- لتجاوز سياسة عدم الإزعاج (DND) وتعديل مستويات القنوات المكتومة -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- إعادة تشغيل جدولة الإعلانات بعد إقلاع الجهاز -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- لمنبهات إعلان الوقت الدقيقة عبر AlarmManager (setExactAndAllowWhileIdle):
         يُمنح تلقائياً بلا طلب وقت التشغيل؛ وبدونه نستخدم جدولة غير دقيقة بنافذة
         قصيرة تعمل دائماً بلا إذن (وقت الإعلان مقرّب قليلاً) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- إبقاء معالج الـ CPU نشطاً أثناء إقلاع محرك TTS ونطق الوقت من أداة
         الساعة (goAsync + WakeLock مؤقت) حتى لا يجمد النظام العملية قبل الصوت -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- الاستجابة اللمسية لأداة الساعة الناطقة (Haptic عند الضغط) — إذن عادي
         يُمنح عند التثبيت تلقائياً -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- لطلب إعفاء من تحسين البطارية (للخدمة الخلفية): يتيح فتح نافذة نية
         ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS مباشرة لنطاق الحزمة المطلوب،
         ويُرتبط بقسم «إرشادات توافق الجهاز» (المحور الثالث). يستحسن طلبه
         حصرياً من زر الإرشاد داخل القسم — لا يُطلب عند الإقلاع أبداً -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- لسماع بث PHONE_STATE ومعرفة حالة المكالمة (إعلان المتصل) —
         يُطلب وقت التشغيل عند تفعيل الميزة -->
    <!-- ع٤١-ب9: إعلان حالة أجهزة البلوتوث عند الاتصال/الفصل وقراءة اسمها.
         BLUETOOTH_CONNECT وقت التشغيل على API 31+، وBLUETOOTH القديم
         (يُمنح تلقائياً عند التثبيت) لِما قبلها — يُطفأ على 31+ لأنه مستبدل. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- ع٤١-ب8: الردّ/الرفض بمفاتيح الصوت أثناء الرنين عبر TelecomManager.
         يُطلب وقت التشغيل عند تفعيل الميزة؛ وبدونه تبقى الميزة معطّلة. -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- إجراء المكالمات وإدارتها لهاتف Lord TTS الميسّر -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <!-- إعلان المتصل [READ_CONTACTS] — للبحث عن اسم المتصل في دفتر الاتصالات.
         سياسة Google Play: هذه الأذونات القيود (بيانات دفتر الاتصال) معرّضة
         لطلب "Permissions Declaration Form" عند رفع الـ APK على Play Console.
         التبرير المطلوب في الاستمارة: تطبيق إتاحة (Accessibility) للمكفوفين
         وضعاف البصر، يُنطق اسم المتصل بالصوت عند وصول مكالمة. يجب إرفاق
         فيديو استخدام يوضح الميزة. ممنوع حذف الإذن أو خفض الوظيفة. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- إعلان المتصل [READ_CALL_LOG] — الوصول إلى رقم المتصل على أندرويد 12+
         (بدونه لا يُسلَّم EXTRA_INCOMING_NUMBER إلا لطلبات الاتصال الافتراضية)
         والبحث عن الاسم في سجل المكالمات. سياسة Google Play: إذن قيود يتطلب
         "Permissions Declaration Form" عند الرفع على Play Console بعنوان
         تطبيق إتاحة (Accessibility) للمكفوفين وضعاف البصر مع فيديو استخدام
         يوضح إعلان المتصل. لا يُحذف: ميزة إعلان المتصل مبنية عليه. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- قراءة الرسائل الواردة [RECEIVE_SMS] — نطق محتوى الرسائل النصية الواردة
         بالصوت للمكفوفين وضعاف البصر. سياسة Google Play: SMS/Receiving innately
         مقيّدة وقد تُرفض تلقائياً لغير تطبيق الرسائل الافتراضي؛ رفعها يتطلب
         "Permissions Declaration Form" مع تبرير الإتاحة (Accessibility) وفيديو
         استخدام يوضح قراءة الرسائل اللفظية. ممنوع حذفها (الميزة تعمل بها فعلاً)
         لكن يجب تجهيز نص التبرير في PLAY_STORE_PERMISSIONS_JUSTIFICATION.md. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- لا يُشترط وجود عتاد مهاتفة خلوي لتمكين التثبيت على الحواسيب والأجهزة اللوحية (ChromeOS) -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- الوصول للإنترنت لفحص وجود تحديث جديد من GitHub Releases وتنزيل الـ APK.
         يُستخدم للفحص/التحميل فقط؛ لا تُرفع أي بيانات أو إعدادات للمستخدم. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- تنزيل تحديثات التطبيق دون إظهار إشعارات تنزيل زائدة في شريط الإشعارات -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />
    <!-- استشعار حالة الاتصال بالإنترنت لتسجيل ConnectivityManager.NetworkCallback
         والتراجع الفوري للأصوات المحلية عند انقطاع الإنترنت بدل انتظار مهلة
         التوليد كاملة (صوت جوجل السحابي يعجز بدون اتصال). إذن عادي يُمنح تلقائياً. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- طلب تثبيت حزم من مصادر خارجية (تفعيل ميزة التحديث الذاتي).
         لا يثبّت شيئاً صمتاً: يعرض شاشة موافقة النظام دائماً. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- الخدمة الأمامية لتسجيل المكالمات بنوع الميكروفون (الأمر 6) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- مراقبة خروج التطبيقات المصرفية والمحمية (الأمر 7) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- الكتابة بالصوت للوحة مفاتيح Lord TTS الميسّرة -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- مطلوب للتبديل بين محركات نطق النظام افتراضياً (يُمنح عبر adb pm grant) -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- رؤية محركات TTS الطرفية (package visibility على أندرويد 11+):
         بدون هذا لا يرى ناطق إلا المحركات المدمجة (سامسونج/جوجل)،
         ويخفي eSpeak وMultiTTS وسائر محركات المستخدم. -->
    <queries>
        <!-- استعلام عن تطبيقات الإطلاق لتغطية «صوت لكل تطبيق» والتطبيقات المحمية (الأمر 5 والأمر 7) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- رؤية حزم أجهزة المكوّنات (package visibility) لقسم «إرشادات توافق
             الجهاز»: تُفتح شاشات إدارة التشغيل التلقائي عبر Activity ComponentName
             صريح، وبدون هذه البُنود يرمي النظام SecurityException على أندرويد 11+
             فيفشل الزر صامتاً حتى لو كانت مستهدفات النية صحيحة -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.vivo.permissionmanager" />
    </queries>

    <application
        android:name=".NateqApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nateq"
        tools:targetApi="37">

        <!-- ============================================= -->
        <!-- خدمة محرك النطق - هذا هو قلب التطبيق          -->
        <!-- يجب أن يكون android:exported="true" ليتعرف    -->
        <!-- عليه النظام وقارئ الشاشة كمحرك TTS متاح        -->
        <!-- ============================================= -->
        <service
            android:name="com.aymankhattab.nateq.core.audio.engine.NateqTtsService"
            android:process=":tts"
            android:exported="true"
            android:directBootAware="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_TTS_SERVICE">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>

        <!-- ============================================= -->
        <!-- خدمة إمكانية الوصول وقراءة الشاشة (ع٢٧-1)       -->
        <!-- ============================================= -->
        <service
            android:name="com.aymankhattab.nateq.core.audio.accessibility.NateqAccessibilityService"
            android:process=":tts"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:description="@string/accessibility_service_description"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nateq_accessibility_config" />
        </service>

        <!-- شاشة التطبيق الرئيسية (أيقونة الشاشة الرئيسية) -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- معالج الإعداد الأولي القابل للتخطي: يُعرض مرة واحدة (اختيار
             لغة الواجهة ومحرك النطق) ولا يُصدَّر لأي تطبيق خارجي -->
        <activity
            android:name=".settings.FirstRunSetupActivity"
            android:exported="false"
            android:label="@string/first_run_welcome_title" />

        <!-- شاشة تفعيل خدمات إمكانية الوصول وقراءة الشاشة (ع٢٧-4) -->
        <activity
            android:name=".settings.AccessibilityOnboardingActivity"
            android:exported="false"
            android:label="@string/a11y_onboarding_title" />

        <!-- شاشة إرشاد منح إذن تبديل محركات نطق النظام WRITE_SECURE_SETTINGS -->
        <activity
            android:name="com.aymankhattab.nateq.settings.WriteSecureSettingsGuideActivity"
            android:exported="false"
            android:label="@string/title_write_secure_settings_guide" />

        <!-- شاشة فحص توافق التطبيقات المصرفية (إنستاباي) + معالج «اعزل السبب» -->
        <activity
            android:name="com.aymankhattab.nateq.settings.banking.BankingCompatCheckActivity"
            android:exported="false"
            android:label="@string/title_banking_compat_check"
            android:theme="@style/Theme.Nateq" />

        <!-- شاشة إدارة الميزات الإضافية (ع٥٦) -->
        <activity
            android:name="com.aymankhattab.nateq.settings.extras.ExtrasSettingsActivity"
            android:exported="false"
            android:label="@string/extras_settings_title"
            android:theme="@style/Theme.Nateq" />

        <!-- نافذة دوّار العناصر الشفافة (ع٥٦-أمر 1) -->
        <activity
            android:name="com.aymankhattab.nateq.settings.extras.RotorActivity"
            android:exported="false"
            android:label="@string/rotor_title"
            android:theme="@style/Theme.Nateq" />

        <!-- نافذة البحث النصي داخل الشاشة (ع٥٦-أمر 2) -->
        <activity
            android:name="com.aymankhattab.nateq.settings.extras.ScreenSearchActivity"
            android:exported="false"
            android:label="@string/search_screen_title"
            android:theme="@style/Theme.Nateq" />

        <!-- Activity لفحص بيانات TTS (اللغات/الأصوات المتاحة) — مطلوبة من سامسونج -->
        <activity
            android:name=".settings.CheckTtsDataActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Activity لتوفير نص تجريبي لكل لغة — مطلوبة من نظام TTS -->
        <activity
            android:name=".settings.GetSampleTextActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- مستقبل أحداث توصيل وفصل الشاحن (مستثناة صراحة من قيود البث في الخلفية) -->
        <!-- BATTERY_CHANGED يُسجَّل ديناميكياً من AnnouncementSchedulerService -->
        <receiver
            android:name="com.aymankhattab.nateq.core.audio.announcement.BatteryAnnouncementReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- مستقبل إعلان اسم المتصل الوارد -->
        <!-- exported=true + permission=READ_PHONE_STATE ضروريان معاً لوصول
             بث PHONE_STATE المحمي من النظام إلى هذا المستقبل -->
        <receiver
            android:name="com.aymankhattab.nateq.core.audio.announcement.CallerAnnouncementReceiver"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- إعادة تشغيل جدولة الإعلانات (الساعة/البطارية) بعد إقلاع الجهاز،
         وبعد تحديث التطبيق (كلاهما يمسح منبهات النظام) -->
        <receiver
            android:name="com.aymankhattab.nateq.core.audio.announcement.AnnouncementBootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- مستقبل إعلان الوقت المستقل: يُوقَظ عبر AlarmManager عند رأس الفاصل
             حتى لو قُتلت العملية أو تجمّدت في Doze، وينطق الوقت ويرسب المنبه
             التالي بنفسه (بند 9 — لا مؤقتات داخل RAM تُفقد). غير مُصدَّر للخارج،
             لا يستقبل إلا بثّ PendingIntent الخاص بالتطبيق -->
        <receiver
            android:name="com.aymankhattab.nateq.core.audio.announcement.TimeAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.aymankhattab.nateq.action.TIME_ANNOUNCE_TICK" />
            </intent-filter>
        </receiver>

        <!-- الخدمة الأمامية للإعلانات الدورية: تستضيف جدولة الساعة ومستقبل
             البطارية في عملية التطبيق الرئيسية (لا عملية المحرك :tts) وتعمل
             بإشعار دائم قابل للإيقاف، مع زرار "أعلن الآن".
             specialUse محفوظ عمداً بقرار المدير: نوع WorkInUnconstrained
             معدوم في جرات المنصة المثبتة 34–37.0، وspecialUse مع خاصية
             PROPERTY_SPECIAL_USE_FGS_SUBTYPE هو التوثيق الرسمي المقبول
             للخدمات العامة بلا مهلة (الاستعمال المعلَن spoken_time_and_battery). -->
        <service
            android:name="com.aymankhattab.nateq.core.audio.announcement.AnnouncementSchedulerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/app_name"
            tools:ignore="ForegroundServiceType">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="spoken_time_and_battery_announcements" />
        </service>

        <!-- خدمة تنزيل أصوات النماذج في الخلفية بخدمة أمامية dataSync (ع٣٠-7) -->
        <service
            android:name="com.aymankhattab.nateq.core.audio.providers.VoiceDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- مستقبل قراءة الرسائل الواردة -->
        <receiver
            android:name="com.aymankhattab.nateq.core.audio.announcement.SmsReadingReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- خدمة قراءة الإشعارات - تحتاج إذن يدوي من الإعدادات -->
        <service
            android:name="com.aymankhattab.nateq.core.audio.announcement.NateqNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- خدمة فرز المكالمات: أسرع مصدرٍ لهوية المتصل (تُنادى قبل الرنّة).
     تحتاج دور CALL_SCREENING من إعدادات النظام؛ ولا نطلب إذناً. -->
        <service
            android:name="com.aymankhattab.nateq.core.audio.announcement.CallerScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_CALL_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- بلاطة الإعدادات السريعة: مفتاح رئيسي واحد لإعلانات التطبيق -->
        <service
            android:name=".settings.AnnouncementTileService"
            android:exported="true"
            android:icon="@drawable/ic_number_reading"
            android:label="@string/tile_label_on"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- بلاطة الإعدادات السريعة لخدمات الشاشة (ع٢٩-14) — تظهر في Quick Settings -->
        <service
            android:name=".settings.ScreenServicesTileService"
            android:exported="true"
            android:icon="@drawable/ic_accessibility"
            android:label="@string/tile_service_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- بلاطة تبديل محرك Lord TTS، مستقلة عن اتصال خدمة المحرك نفسها. -->
        <service
            android:name=".settings.NextEngineTileService"
            android:exported="true"
            android:icon="@drawable/ic_number_reading"
            android:label="@string/tile_next_engine_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- بلاطة تبديل محرك Lord TTS إلى المحرك السابق. -->
        <service
            android:name=".settings.PreviousEngineTileService"
            android:exported="true"
            android:icon="@drawable/ic_number_reading"
            android:label="@string/tile_previous_engine_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- مستقبل استئناف خدمات الشاشة التلقائي (ع٢٧-14) -->
        <receiver
            android:name="com.aymankhattab.nateq.core.audio.accessibility.A11yResumeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.aymankhattab.nateq.action.A11Y_RESUME" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>


        <!-- FileProvider: يعرض ملف الـ APK المُنزَل لمثبّت الحزم (package installer)
             عبر رابطة content:// آمنة (الملف محلي ولا يُرفع لأي طرف).
             exported="false" + grantUriPermissions="true" لصلاح مشاركة اللوجات
             مع تطبيقات خارجية (Telegram، البريد، إلخ) على Android 10+. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- مزود تشخيص القاموس في عملية :tts لاختبار المسار الحقيقي (الأمر 2) -->
        <provider
            android:name="com.aymankhattab.nateq.core.audio.engine.DictTestProvider"
            android:authorities="${applicationId}.dict_test_provider"
            android:process=":tts"
            android:exported="false" />

        <!-- مزود تقارير التشخيص الصادقة في عملية :tts (الجولة 53 - الأمر 2) -->
        <provider
            android:name="com.aymankhattab.nateq.core.audio.engine.TtsDiagnosticsProvider"
            android:authorities="${applicationId}.tts_diagnostics"
            android:process=":tts"
            android:exported="false" />
        <!-- خدمة لوحة مفاتيح Lord TTS الميسّرة لذوي الإعاقة البصرية -->
        <service
            android:name="com.aymankhattab.nateq.core.audio.keyboard.LordKeyboardService"
            android:exported="true"
            android:label="@string/keyboard_service_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- شاشة إعدادات وتخصيص لوحة مفاتيح Lord TTS الميسّرة -->
        <activity
            android:name="com.aymankhattab.nateq.settings.KeyboardSettingsActivity"
            android:exported="true"
            android:label="@string/keyboard_settings_title" />

        <!-- خدمة إدارة المكالمات InCallService لهاتف Lord TTS -->
        <service
            android:name="com.aymankhattab.nateq.core.audio.phone.LordInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="true" />
        </service>

        <!-- نشاط هاتف Lord TTS الميسّر ولوحة الاتصال -->
        <activity
            android:name="com.aymankhattab.nateq.settings.phone.LordPhoneActivity"
            android:exported="true"
            android:label="@string/phone_app_name"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.CALL_BUTTON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- اختصار أيقونة هاتف Lord TTS في شاشة التطبيقات -->
        <activity-alias
            android:name="com.aymankhattab.nateq.settings.phone.LordPhoneLauncherAlias"
            android:targetActivity="com.aymankhattab.nateq.settings.phone.LordPhoneActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_call"
            android:label="@string/phone_app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- شاشة المكالمة الجارية والواردة لهاتف Lord TTS -->
        <activity
            android:name="com.aymankhattab.nateq.settings.phone.LordInCallActivity"
            android:exported="false"
            android:label="@string/phone_app_name"
            android:launchMode="singleTop"
            android:showOnLockScreen="true"
            android:turnScreenOn="true" />

        <!-- الخدمة الأمامية لتسجيل المكالمات (الأمر 6) -->
        <service
            android:name="com.aymankhattab.nateq.core.audio.phone.CallRecordingForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- الخدمة الأمامية لمراقبة التطبيقات المحمية (الأمر 7) -->
        <service
            android:name="com.aymankhattab.nateq.core.audio.accessibility.ProtectedAppWatcherService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Protected bank and payment app watcher to safely restore accessibility" />
        </service>

        <!-- مستقبل المنبه الاحتياطي لإعادة تفعيل إمكانية الوصول (الجولة 51 و52) -->
        <receiver
            android:name="com.aymankhattab.nateq.core.audio.accessibility.ProtectedAppRestoreReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.aymankhattab.nateq.action.RESTORE_ALARM" />
                <action android:name="com.aymankhattab.nateq.action.A11Y_CONNECTED" />
                <action android:name="com.aymankhattab.nateq.action.A11Y_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- نشاط فتح التطبيق المحمي بضمان التعطيل المسبق (الأمر 7) -->
        <activity
            android:name="com.aymankhattab.nateq.settings.ProtectedAppLauncherActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- شاشة إعدادات هاتف Lord TTS وتسجيل المكالمات -->
        <activity
            android:name="com.aymankhattab.nateq.settings.phone.PhoneSettingsActivity"
            android:exported="true"
            android:label="@string/phone_settings_title" />

        <!-- شاشة الاتصال السريع الميسّرة لهاتف Lord TTS (ذاكرة 1-10000) -->
        <activity
            android:name="com.aymankhattab.nateq.settings.phone.LordSpeedDialActivity"
            android:exported="true"
            android:label="@string/speed_dial_title" />

        <!-- اختصار أيقونة الاتصال السريع في شاشة التطبيقات -->
        <activity-alias
            android:name="com.aymankhattab.nateq.settings.phone.LordSpeedDialLauncherAlias"
            android:targetActivity="com.aymankhattab.nateq.settings.phone.LordSpeedDialActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_call"
            android:label="@string/speed_dial_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>
</manifest>
