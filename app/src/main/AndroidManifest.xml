<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- الأذونات المطلوبة فقط - بدون أي إذن زائد -->
    <!-- مطلوب من أندرويد 13 (API 33) فأعلى لو استخدمنا إشعار الخدمة الأمامية -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- اختياري: إشعار أثناء التخليق الصوتي الطويل (نصوص كبيرة) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- الخدمة الأمامية الخاصة بالإعلانات الدورية (نوع متخصص لا يقيده
         أندرويد 15 عند الإقلاع، بخلاف mediaPlayback) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- ضروري لطلب Audio Focus قبل نطق الإعلان (بدونه يرمي النظام
         SecurityException ويُبتلع طلب التركيز فيفشل صوت الخلفية) — إذن عادي
         يُمنح عند التثبيت تلقائياً بلا طلب وقت التشغيل -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- إعادة تشغيل جدولة الإعلانات بعد إقلاع الجهاز -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- لمنبهات إعلان الوقت الدقيقة عبر AlarmManager (setExactAndAllowWhileIdle): 
         يُمنح تلقائياً بلا طلب وقت التشغيل، ومع بديل setAlarmClock يعمل إعلان
         الوقت حتى في Doze دون هذا الإذن أيضاً -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- لطلب إعفاء من تحسين البطارية (للخدمة الخلفية) -->

    <!-- لسماع بث PHONE_STATE ومعرفة حالة المكالمة (إعلان المتصل) —
         يُطلب وقت التشغيل عند تفعيل الميزة -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- للبحث عن اسم المتصل في دفتر الاتصالات (إعلان المتصل) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- للوصول إلى رقم المتصل على أندرويد 12+ — بدونه أو بدون أن يكون
         التطبيق الافتراضي للاتصال لا يُسلَّم النظامُ رقمَ المتصل (EXTRA_INCOMING_NUMBER).
         يستخدمه ناطق أيضاً للبحث عن الاسم في سجل المكالمات -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- لقراءة الرسائل النصية الواردة بالصوت (قراءة الرسائل) -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- رؤية محركات TTS الطرفية (package visibility على أندرويد 11+):
         بدون هذا لا يرى ناطق إلا المحركات المدمجة (سامسونج/جوجل)،
         ويخفي eSpeak وMultiTTS وسائر محركات المستخدم. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".NateqApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LordTts"
        tools:targetApi="37">

        <!-- ============================================= -->
        <!-- خدمة محرك النطق - هذا هو قلب التطبيق          -->
        <!-- يجب أن يكون android:exported="true" ليتعرف    -->
        <!-- عليه النظام وقارئ الشاشة كمحرك TTS متاح        -->
        <!-- ============================================= -->
        <service
            android:name=".engine.NateqTtsService"
            android:process=":tts"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_TTS_SERVICE">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.tts"
                android:resource="@xml/tts_engine" />
        </service>

        <!-- شاشة الإعدادات الرئيسية (اختيار الأصوات، إعدادات متقدمة) -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity لفحص بيانات TTS (اللغات/الأصوات المتاحة) — مطلوبة من سامسونج -->
        <activity
            android:name=".settings.CheckTtsDataActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.tts.engine.CHECK_TTS_DATA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Activity لتوفير نص تجريبي لكل لغة — مطلوبة من نظام TTS -->
        <activity
            android:name=".settings.GetSampleTextActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.tts.engine.GET_SAMPLE_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- مستقبل البطارية يُسجَّل ديناميكياً من AnnouncementSchedulerService -->
        <!-- لا يُسجَّل هنا لأن BATTERY_CHANGED ممنوع في الـ manifest منذ أندرويد 8+ (API 26) -->

        <!-- مستقبل إعلان اسم المتصل الوارد -->
        <!-- exported=true + permission=READ_PHONE_STATE ضروريان معاً لوصول
             بث PHONE_STATE المحمي من النظام إلى هذا المستقبل -->
        <receiver
            android:name=".receivers.CallerAnnouncementReceiver"
            android:exported="true"
            android:permission="android.permission.READ_PHONE_STATE">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- إعادة تشغيل جدولة الإعلانات (الساعة/البطارية) بعد إقلاع الجهاز -->
        <receiver
            android:name=".engine.AnnouncementBootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- مستقبل إعلان الوقت المستقل: يُوقَظ عبر AlarmManager عند رأس الفاصل
             حتى لو قُتلت العملية أو تجمّدت في Doze، وينطق الوقت ويرسب المنبه
             التالي بنفسه (بند 9 — لا مؤقتات داخل RAM تُفقد). غير مُصدَّر للخارج،
             لا يستقبل إلا بثّ PendingIntent الخاص بالتطبيق -->
        <receiver
            android:name=".receivers.TimeAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.aymankhattab.nateq.action.TIME_ANNOUNCE_TICK" />
            </intent-filter>
        </receiver>

        <!-- الخدمة الأمامية للإعلانات الدورية: تستضيف جدولة الساعة ومستقبل
             البطارية في عملية التطبيق الرئيسية (لا عملية المحرك :tts) وتعمل
             بإشعار دائم قابل للإيقاف، مع زرار "أعلن الآن" -->
        <service
            android:name=".engine.AnnouncementSchedulerService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/app_name"
            tools:ignore="ForegroundServiceType">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="spoken_time_and_battery_announcements" />
        </service>

        <!-- مستقبل قراءة الرسائل الواردة -->
        <receiver
            android:name=".receivers.SmsReadingReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- خدمة قراءة الإشعارات - تحتاج إذن يدوي من الإعدادات -->
        <service
            android:name=".receivers.NateqNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- بلاطة الإعدادات السريعة: مفتاح رئيسي واحد لإعلانات التطبيق -->
        <service
            android:name=".settings.AnnouncementTileService"
            android:exported="true"
            android:icon="@drawable/ic_number_reading"
            android:label="@string/tile_label_on"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- أداة الساعة الناطقة على الشاشة الرئيسية (تنطق الوقت عند اللمس) -->
        <receiver
            android:name=".widget.SpeakingClockWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/speaking_clock_widget_info" />
        </receiver>

    </application>
</manifest>
