<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tv_convert_dialog_saved"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceBody2" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_convert_play"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/cd_test_voice_button" />
        </LinearLayout>

        <!-- اختيار المحرك -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_convert_engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/auto_convert_engine">
            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinner_convert_engine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:focusable="true"
                android:importantForAccessibility="yes" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- اختيار اللغة (ينبثق عن المحرك المختار) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_convert_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/auto_convert_language">
            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinner_convert_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:focusable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- اختيار الصوت (ينبثق عن اللغة المختارة) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_convert_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/auto_convert_voice">
            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinner_convert_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:focusable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- مستوى الصوت -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/auto_convert_volume"
                android:textAppearance="?attr/textAppearanceBody2"
                android:contentDescription="@string/auto_convert_volume" />
            <TextView
                android:id="@+id/tv_convert_volume_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textAppearance="?attr/textAppearanceBody2" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/seek_convert_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"
            android:contentDescription="@string/auto_convert_volume" />

        <!-- النبرة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/auto_convert_pitch"
                android:textAppearance="?attr/textAppearanceBody2"
                android:contentDescription="@string/auto_convert_pitch" />
            <TextView
                android:id="@+id/tv_convert_pitch_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0x"
                android:textAppearance="?attr/textAppearanceBody2" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/seek_convert_pitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="100"
            android:contentDescription="@string/auto_convert_pitch" />

        <!-- السرعة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/auto_convert_rate"
                android:textAppearance="?attr/textAppearanceBody2"
                android:contentDescription="@string/auto_convert_rate" />
            <TextView
                android:id="@+id/tv_convert_rate_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0x"
                android:textAppearance="?attr/textAppearanceBody2" />
        </LinearLayout>
        <SeekBar
            android:id="@+id/seek_convert_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="100"
            android:contentDescription="@string/auto_convert_rate" />

        <!-- زر الحفظ داخل اللوحة -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_convert_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/auto_convert_save"
            android:importantForAccessibility="yes" />

    </LinearLayout>
</ScrollView>