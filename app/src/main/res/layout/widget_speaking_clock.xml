<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_launcher_background"
    android:contentDescription="@string/widget_clock_tap_to_speak"
    android:gravity="center"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- الأطفال غير مهمين للقارئ: الجذر وحده يحمل الوصف و action النقر
         (نقرتان من TalkBack تُشغّلان النطق) -->
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_number_reading"
        android:tint="@color/widget_foreground" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:text="@string/widget_clock_tap_to_speak"
        android:textColor="@color/widget_foreground"
        android:textSize="14sp" />

</LinearLayout>