<?xml version="1.0" encoding="utf-8"?>
<tts-engine xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.aymankhattab.nateq.settings.SettingsActivity">
    <voice android:name="ar-EG" />
    <voice android:name="en-US" />
    <!-- اللغات القارية المدعومة بكشف اللاتينية (fr/de/es): تُعلن هنا
         بنفس صيغة VoiceIdContract (اسم اللغة نفسه كـ Locale صالح —
         "fr"/"de"/"es") حتى تظهر في قوائم النظام الثابتة/بعض مشغّلات
         سامسونج دون انتظار onGetVoices الديناميكي؛ النطق الفعلي يذهب
         للمحرك الطرفي إن وُجد وإلا يسقط أماناً للغة الطلب. الصيغة القديمة
         "<lang>-local" كانت تكسر شاشة TTS في سامسونج لأنها ليست Locale
         صالحاً (Locale.forLanguageTag تفشل عليها) فتنهار إعدادات النظام. -->
    <voice android:name="fr" />
    <voice android:name="de" />
    <voice android:name="es" />
</tts-engine>
