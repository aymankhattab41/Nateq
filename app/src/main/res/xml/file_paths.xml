<?xml version="1.0" encoding="utf-8"?>
<!-- مسارات قابلة للمشاركة عبر FileProvider لتثبيت الـ APK المُنزَل.
     مسار التنزيل في التخزين الخارجي المُخصَّص للتطبيق (getExternalFilesDir)
     لأن DownloadManager يرفض وجهات app_internal على أندرويد 10+. -->
<paths>
