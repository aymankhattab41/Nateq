<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ll_group_embedded_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:padding="4dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:accessibilityHeading="true"
        android:importantForAccessibility="yes">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:text="@string/group_embedded_engines_title"
            android:textAppearance="?attr/textAppearanceHeadline6" />

        <TextView
            android:id="@+id/tv_group_embedded_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/ic_chevron_right"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_group_embedded_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- بطاقة تنزيل وإدارة أصوات المحركات المدمجة -->
        <LinearLayout
            android:id="@+id/ll_embedded_downloader_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:padding="4dp"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:accessibilityHeading="true"
            android:importantForAccessibility="yes">

            <TextView
                android:id="@+id/tv_embedded_downloader_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:text="@string/section_embedded_downloader_title"
                android:textAppearance="?attr/textAppearanceHeadline6" />

            <TextView
                android:id="@+id/tv_embedded_downloader_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:paddingEnd="4dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tv_embedded_downloader_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:textSize="14sp"
                android:paddingStart="4dp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_embedded_downloader_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/embedded_header_desc"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <!-- قائمة حالة المحركات الثلاثة (ع٢٩-8 بند 2): تُعرض دائماً مع
                 شارة الحالة، ضغطة تفتح حوار تفاصيل (السبب، المسار، الحجم،
                 إعادة المحاولة، نسخ التشخيص). -->
            <LinearLayout
                android:id="@+id/ll_engine_status_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:padding="4dp" />

            <!-- تبديل المحرك: Piper أو Vocalizer أو Acapela -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_group_engine_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_engine_piper"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/embedded_engine_piper" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_engine_vocalizer"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/embedded_engine_vocalizer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_engine_acapela"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/embedded_engine_acapela" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- زر استيراد باقة صوت ZIP -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_import_voice_zip"
                style="?attr/materialButtonTonalStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/embedded_import_zip"
                app:icon="@drawable/ic_folder_zip"
                app:iconGravity="textStart" />

            <!-- أزرار الفلترة حسب اللغة -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_group_lang_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_all"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/embedded_filter_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_ar"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/embedded_filter_ar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_en"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/embedded_filter_en" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_other"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/embedded_filter_other" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- قائمة بطاقات الأصوات -->
            <LinearLayout
                android:id="@+id/ll_piper_voices_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_embedded_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/embedded_empty_list"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="4dp"
        android:background="@color/divider_color" />

</LinearLayout>
