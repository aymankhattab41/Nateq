<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_detail_engine_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/divider_color" />

        <TextView
            android:id="@+id/tv_detail_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textAppearance="?attr/textAppearanceBody2" />

        <TextView
            android:id="@+id/tv_detail_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tv_detail_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/design_default_color_error" />

        <TextView
            android:id="@+id/tv_detail_paths"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="@color/text_secondary"
            android:maxLines="5"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_detail_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="?attr/textAppearanceBody2" />

        <TextView
            android:id="@+id/tv_detail_files_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ll_detail_files_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_detail_host_log_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/engine_detail_host_log_title"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_detail_host_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="@color/text_secondary"
            android:fontFamily="monospace"
            android:maxLines="15"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_diagnostics"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/copy_diagnostics" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry_init"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/retry_init" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_engine_data"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/design_default_color_error"
            android:text="@string/engine_delete_all_data" />

    </LinearLayout>
</ScrollView>